{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/thalesfb/ccw/prototype/contracts/interaction.schema.json",
  "title": "Canonical student-item interaction",
  "description": "Normalized event used by the TCC prototype. All identifiers must be anonymous or dataset-native public identifiers.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "student_id",
    "item_id",
    "skill_ids",
    "interaction_order",
    "correct",
    "source_dataset",
    "source_row_id"
  ],
  "properties": {
    "student_id": {
      "type": "string",
      "minLength": 1
    },
    "item_id": {
      "type": "string",
      "minLength": 1
    },
    "skill_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "interaction_order": {
      "type": "integer",
      "minimum": 0
    },
    "timestamp": {
      "type": ["string", "null"],
      "format": "date-time"
    },
    "correct": {
      "type": "boolean"
    },
    "answer": {
      "type": ["string", "number", "null"]
    },
    "attempt_count": {
      "type": ["integer", "null"],
      "minimum": 0
    },
    "hint_count": {
      "type": ["integer", "null"],
      "minimum": 0
    },
    "elapsed_time_ms": {
      "type": ["integer", "null"],
      "minimum": 0
    },
    "session_id": {
      "type": ["string", "null"]
    },
    "source_dataset": {
      "type": "string",
      "minLength": 1
    },
    "source_row_id": {
      "type": "string",
      "minLength": 1
    }
  }
}
